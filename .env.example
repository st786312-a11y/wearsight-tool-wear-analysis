# Optional: set locally after the user has obtained official model access.
HF_TOKEN=
# Complete Hugging Face model folder under backend/models, mounted read-only:
# DINOV3_MODEL_PATH=/app/yolo/dinov3-vitb16
DINOV3_MODEL_PATH=

# Optional local DINOv2 folder; otherwise download facebook/dinov2-base.
DINOV2_MODEL_PATH=

# Dify 已發布工作流的 Service API。金鑰只放在本機 .env，不可放進前端或 Git。
DIFY_API_URL=http://host.docker.internal/v1
DIFY_API_KEY=
DIFY_ANALYSIS_URL_BASE=http://host.docker.internal:8000
